# Backend reale del flusso /review/[id], portato da maat-os/apps/web/.env.example.
# COPIA questo file in `.env.local` e riempi i valori. `.env.local` è gitignored: NON committarlo.
# I valori reali (segreti) si condividono via password manager, MAI su git/chat.
#
# Nota: l'app builda e parte anche senza queste variabili — lib/supabase/*.ts e
# lib/storage.ts degradano al passthrough/mock quando mancano (vedi il commento
# "Senza env reali" in lib/supabase/middleware.ts). BFF_WRITER_DATABASE_URL è
# l'unica che throwa a runtime, e solo quando si usa il confirm su /review/[id].
# Stesso progetto Supabase (`maat-dev`) e stesso bucket R2 di maat-os.

# --- Supabase (client browser + middleware) ---
# URL e anon key sono pubblici: NEXT_PUBLIC_* = esposti al client.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- BFF writer (scritture su /review/[id], ruolo bff_writer via Supavisor) ---
BFF_WRITER_DATABASE_URL=

# --- Cloudflare R2 (presigned URL per le foto) ---
R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_BUCKET=maat-photos-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
